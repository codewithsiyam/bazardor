# --- BetterAuth ---
# Generate with: npx @better-auth/cli secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Local: http://localhost:3000   Production: your deployed URL, e.g. https://bazardor.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# --- Database (MongoDB Atlas free tier works) ---
MONGODB_URI=
MONGODB_DB=bazardor

# --- OAuth (optional until you create the apps; buttons still render without them) ---
# Callback URLs:  {BETTER_AUTH_URL}/api/auth/callback/google  and  /callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Optional API overrides ---
# BAZARDOR_API_URL=https://api.api-store.workers.dev/api/bazardor
# BAZARDOR_API_URL_FALLBACK=https://api.abcz.workers.dev/api/bazardorg