# ─────────────────────────────────────────────────────────────
# BazarDor (বাজার দর) — environment variables
# Copy this file to `.env.local` and fill in the real values.
# NEVER commit `.env.local` or paste real secrets in this file.
# ─────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────
# MongoDB Atlas connection string (Atlas → Connect → Drivers).
# Include a database name in the path, e.g. /bazardor
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/bazardor?retryWrites=true&w=majority

# Long random string (32+ chars). Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Public base URL of THIS app (no trailing slash).
# Local: http://localhost:3000   Production: https://your-app.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# ── Recommended ──────────────────────────────────────────────
# Same public URL, used for metadata (metadataBase). Safe to expose.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional ─────────────────────────────────────────────────
# Database name override (otherwise the name inside MONGODB_URI is used).
# MONGODB_DB_NAME=bazardor

# Override the primary API base URL (default: api-store.workers.dev).
# BAZARDOR_API_URL=https://api.api-store.workers.dev/api/bazardor

# ── Social login (the buttons appear ONLY when both values are set) ──
# Google:  Authorized redirect URI → <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub:  Authorization callback URL → <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
